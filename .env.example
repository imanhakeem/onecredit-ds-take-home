# Copy this file to .env and fill in your key. .env is git-ignored; never commit it.
# Free Gemini key: https://aistudio.google.com/apikey
LLM_API_KEY=

# Defaults, change if you use another OpenAI-compatible provider (Groq, OpenRouter, ...)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash
# Requests per minute to stay under the free tier's limit
LLM_RPM=8
# Thinking budget: none | low | medium | high (low keeps it fast and cheap)
LLM_REASONING_EFFORT=low
